# DSLighting minimal config example / DSLighting 最小配置示例
#
# Copy this file to config.yaml and edit as needed.
# 复制本文件为 config.yaml 后按需修改。
#
# Used by:
# - Benchmark task list defaults (competitions / sciencebench_competitions)
# - Custom model pricing for cost accounting (custom_model_pricing)
# 用途：
# - Benchmark 默认任务列表（competitions / sciencebench_competitions）
# - 成本统计的模型单价覆盖（custom_model_pricing）

# Default benchmark tasks (MLE/DABench style)
# 默认 benchmark 任务列表（MLE/DABench 风格）
competitions:
  - bike-sharing-demand
  - titanic

# Optional ScienceBench task list
# 可选：ScienceBench 任务列表
sciencebench_competitions:
  - sciencebench-001-clintox-nn

# Optional custom model pricing (token-level USD)
# 可选：自定义模型价格（按 token 的美元价格）
custom_model_pricing:
  openai/deepseek-ai/DeepSeek-V3.1-Terminus:
    input_cost_per_token: 5.55e-07
    output_cost_per_token: 1.67e-06
